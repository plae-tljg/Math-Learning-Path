---
import { getPath } from '../utils/path';
import { t, getLangPath, type Lang } from '../utils/i18n';

interface Props {
	lang: Lang;
	currentPath: string;
}

const { lang, currentPath } = Astro.props;

// 扩展导航项
const navItems = [
	{ key: 'nav.home', path: '/zh/' },
	{ key: 'nav.getting-started', path: '/zh/getting-started' },
	{ key: 'nav.university', path: '/zh/university' },
];

const items = navItems.map(item => ({
	name: t(item.key, lang),
	path: getPath(item.path.replace('/zh/', `/${lang}/`))
}));

const otherLang: Lang = lang === 'zh' ? 'en' : 'zh';
const basePath = import.meta.env.BASE_URL;
const relativePath = currentPath.startsWith(basePath) 
	? currentPath.slice(basePath.length - 1)
	: currentPath;
const otherRelativePath = getLangPath(relativePath, lang, otherLang);
const otherPath = getPath(otherRelativePath);
const homePath = getPath(`/${lang}/`);
const logoText = t('common.title', lang);
---

<nav>
	<div class="nav-container">
		<a href={homePath} class="logo">
			<span class="logo-icon">∑</span>
			<span class="logo-text">{logoText}</span>
		</a>
		<div class="nav-links">
			{items.map((item) => (
				<a
					href={item.path}
					class={currentPath === item.path ? 'active' : ''}
				>
					{item.name}
				</a>
			))}
			<a href={otherPath} class="lang-switch">
				<span class="lang-icon">🌐</span>
				{t('nav.switch-lang', lang)}
			</a>
		</div>
	</div>
</nav>

<style>
	nav {
		background: rgba(15, 23, 42, 0.9);
		backdrop-filter: blur(20px);
		border-bottom: 1px solid rgba(99, 102, 241, 0.2);
		position: sticky;
		top: 0;
		z-index: 100;
	}

	.nav-container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 1rem 2rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.logo {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		text-decoration: none;
		color: #f1f5f9;
		font-weight: 700;
		font-size: 1.25rem;
		transition: all 0.2s ease;
	}

	.logo:hover {
		color: #6366f1;
	}

	.logo-icon {
		font-size: 1.5rem;
		background: linear-gradient(135deg, #6366f1, #ec4899);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.logo-text {
		font-weight: 600;
	}

	.nav-links {
		display: flex;
		gap: 2rem;
		align-items: center;
	}

	.nav-links a {
		text-decoration: none;
		color: #94a3b8;
		font-weight: 500;
		transition: all 0.2s ease;
		padding: 0.5rem 0;
		position: relative;
	}

	.nav-links a:hover {
		color: #f1f5f9;
	}

	.nav-links a.active {
		color: #f1f5f9;
	}

	.nav-links a.active::after {
		content: '';
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		height: 2px;
		background: linear-gradient(90deg, #6366f1, #8b5cf6);
		border-radius: 2px;
	}

	.lang-switch {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-left: 1rem;
		padding: 0.5rem 1rem;
		background: rgba(99, 102, 241, 0.2);
		border-radius: 8px;
		font-size: 0.875rem;
		border: 1px solid rgba(99, 102, 241, 0.3);
	}

	.lang-switch:hover {
		background: rgba(99, 102, 241, 0.3);
		border-color: rgba(99, 102, 241, 0.5);
	}

	.lang-icon {
		font-size: 1rem;
	}

	@media (max-width: 768px) {
		.nav-container {
			flex-direction: column;
			gap: 1rem;
			padding: 1rem;
		}

		.nav-links {
			flex-wrap: wrap;
			justify-content: center;
			gap: 1rem;
		}

		.lang-switch {
			margin-left: 0;
		}
	}
</style>
