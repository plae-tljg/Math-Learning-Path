---
import MathLayout from '../../../layouts/MathLayout.astro';
import { getPath } from '../../../utils/path';

const lang = 'zh';
const currentPath = '/zh/university';
const title = '大学数学';

// 只保留有内容的学科
const subjects = [
	{
		name: '集合论',
		desc: '从空集出发，探索集合的结构与运算',
		href: '/zh/university/set-theory',
		icon: '∅',
		level: 1,
	},
	{
		name: '数理逻辑',
		desc: '逻辑的核心、形式系统与证明理论',
		href: '/zh/university/math-logic',
		icon: '⟂',
		level: 1,
	},
	{
		name: '数论',
		desc: '整数的结构与性质，素数分布的奥秘',
		href: '/zh/university/number-theory',
		icon: 'ℕ',
		level: 2,
	},
	{
		name: '群论',
		desc: '对称性的代数结构，四条公理掌控一切',
		href: '/zh/university/group-theory',
		icon: '⊕',
		level: 3,
	},
	{
		name: '数学分析',
		desc: '实数、极限、连续与微分积分',
		href: '/zh/university/analysis',
		icon: '∫',
		level: 4,
	},
	{
		name: '拓扑学',
		desc: '空间的柔软几何，连续性的本质',
		href: '/zh/university/topology',
		icon: '◈',
		level: 5,
	},
];
---

<MathLayout {title} lang={lang} {currentPath}>
	<article>
		<h1>{title}</h1>
		<p class="intro">探索数学的核心领域，从基础到抽象，逐步深入。</p>

		<h2>学习路径</h2>
		<div class="subjects-grid">
			{subjects.map(subject => (
				<a href={getPath(subject.href)} class="subject-card card">
					<span class="subject-icon">{subject.icon}</span>
					<div class="subject-info">
						<h3>{subject.name}</h3>
						<p>{subject.desc}</p>
					</div>
					<span class="subject-level">L{subject.level}</span>
					<span class="subject-arrow">→</span>
				</a>
			))}
		</div>
	</article>
</MathLayout>

<style>
	.intro {
		font-size: 1.1rem;
		margin-bottom: 2rem;
	}

	.subjects-grid {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.subject-card {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		text-decoration: none;
		transition: all 0.2s ease;
	}

	.subject-card:hover {
		transform: translateX(5px);
		border-color: var(--primary);
	}

	.subject-icon {
		font-size: 2.5rem;
		min-width: 60px;
		text-align: center;
		background: linear-gradient(135deg, var(--primary), var(--secondary));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.subject-info {
		flex: 1;
	}

	.subject-info h3 {
		margin: 0 0 0.25rem 0;
		color: var(--text-primary);
		font-size: 1.25rem;
	}

	.subject-info p {
		margin: 0;
		font-size: 0.9rem;
		color: var(--text-secondary);
	}

	.subject-level {
		padding: 0.25rem 0.5rem;
		background: rgba(99, 102, 241, 0.1);
		border-radius: 4px;
		font-size: 0.75rem;
		font-weight: bold;
		color: var(--primary);
	}

	.subject-arrow {
		font-size: 1.5rem;
		color: var(--primary);
		opacity: 0;
		transition: opacity 0.2s ease;
	}

	.subject-card:hover .subject-arrow {
		opacity: 1;
	}

	@media (max-width: 768px) {
		.subject-card {
			flex-direction: column;
			text-align: center;
			gap: 1rem;
		}

		.subject-level {
			order: -1;
		}

		.subject-arrow {
			display: none;
		}
	}
</style>
