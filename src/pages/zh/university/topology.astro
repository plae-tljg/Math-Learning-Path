---
import MathLayout from '../../../layouts/MathLayout.astro';
import { getPath } from '../../../utils/path';

const lang = 'zh';
const currentPath = '/zh/university/topology';
const title = '拓扑学';
---

<MathLayout {title} {lang} {currentPath}>
	<article>
		<h1>{title}</h1>
		<p class="intro">懒得写，笔给你</p>

		<div class="nav-footer">
			<a href={getPath('/zh/university/analysis')} class="back-link">← 数学分析</a>
			<span class="end-mark">学习路径结束</span>
		</div>
	</article>
</MathLayout>

<style>
	.intro {
		font-size: 1.5rem;
		color: var(--text-secondary);
		margin: 2rem 0;
	}

	.nav-footer {
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid rgba(99, 102, 241, 0.2);
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.back-link {
		color: #6366f1;
		text-decoration: none;
	}

	.end-mark {
		color: var(--text-secondary);
		font-size: 0.9rem;
	}
</style>
