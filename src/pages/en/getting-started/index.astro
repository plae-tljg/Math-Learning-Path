---
import MathLayout from '../../../layouts/MathLayout.astro';
import { getPath } from '../../../utils/path';
import { t } from '../../../utils/i18n';

const lang = 'en';
const currentPath = '/en/getting-started';
const title = t('getting-started.title', lang);

const tips = [
	{
		title: 'Understand, Don\'t Memorize',
		desc: 'Mathematics is not a subject of rote learning. Try to understand why each theorem holds and what problem it solves.',
		icon: '🧠',
	},
	{
		title: 'Take Notes & Derive',
		desc: 'Write down proof processes yourself, don\'t just read. Seeing ≠ Understanding. Being able to write it out is true mastery.',
		icon: '✍️',
	},
	{
		title: 'Build Connections',
		desc: 'Try to find connections between different concepts. Mathematics is an organic whole, not isolated pieces of knowledge.',
		icon: '🔗',
	},
	{
		title: 'Practice Extensively',
		desc: 'Mathematics requires repeated practice. Don\'t be afraid of mistakes. Errors are the best teachers.',
		icon: '📝',
	},
];

const highSchoolTopics = [
	{ name: 'Algebra Basics', desc: 'Equations, functions, polynomials' },
	{ name: 'Geometry', desc: 'Plane geometry, intro to analytic geometry' },
	{ name: 'Trigonometry', desc: 'Sine, cosine, tangent identities' },
	{ name: 'Calculus Intro', desc: 'Basic derivatives, simple integrals' },
];
---

<MathLayout {title} {lang} {currentPath}>
	<article>
		<h1>{title}</h1>
		<p class="intro">{t('getting-started.welcome', lang)}</p>

		<h2>{t('getting-started.tips', lang)}</h2>
		<div class="tips-grid">
			{tips.map(tip => (
				<div class="tip-card card">
					<span class="tip-icon">{tip.icon}</span>
					<h3>{tip.title}</h3>
					<p>{tip.desc}</p>
				</div>
			))}
		</div>

		<h2>{t('getting-started.high-school', lang)}</h2>
		<p class="section-intro">Before starting university mathematics, ensure you have mastered these high school basics:</p>
		<div class="topics-table">
			<table>
				<thead>
					<tr>
						<th>Topic</th>
						<th>Main Content</th>
					</tr>
				</thead>
				<tbody>
					{highSchoolTopics.map(topic => (
						<tr>
							<td>{topic.name}</td>
							<td>{topic.desc}</td>
						</tr>
					))}
				</tbody>
			</table>
		</div>

		<h2>Recommended Resources</h2>
		<div class="resources">
			<a href={getPath('/en/getting-started/high-school-books')} class="resource-link card">
				<span class="resource-icon">📚</span>
				<div class="resource-content">
					<h3>Books from High School</h3>
					<p>My high school mathematics learning resource recommendations</p>
				</div>
				<span class="resource-arrow">→</span>
			</a>
		</div>

		<div class="next-step">
			<p>Ready to dive into university mathematics?</p>
			<a href={getPath('/en/university')} class="next-link">
				Explore University Math →
			</a>
		</div>
	</article>
</MathLayout>

<style>
	.intro {
		font-size: 1.1rem;
		margin-bottom: 2rem;
	}

	.section-intro {
		margin-bottom: 1.5rem;
	}

	.tips-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 1.5rem;
		margin-bottom: 2rem;
	}

	.tip-card {
		text-align: center;
	}

	.tip-icon {
		font-size: 2.5rem;
		display: block;
		margin-bottom: 1rem;
	}

	.tip-card h3 {
		margin: 0 0 0.5rem 0;
		color: #f1f5f9;
		font-size: 1.1rem;
	}

	.tip-card p {
		margin: 0;
		font-size: 0.9rem;
	}

	.topics-table {
		margin-bottom: 2rem;
	}

	.resources {
		margin-bottom: 2rem;
	}

	.resource-link {
		display: flex;
		align-items: center;
		gap: 1rem;
		text-decoration: none;
		position: relative;
	}

	.resource-link:hover .resource-arrow {
		transform: translateX(5px);
	}

	.resource-icon {
		font-size: 2rem;
	}

	.resource-content {
		flex: 1;
	}

	.resource-content h3 {
		margin: 0 0 0.25rem 0;
		color: #f1f5f9;
	}

	.resource-content p {
		margin: 0;
		font-size: 0.9rem;
	}

	.resource-arrow {
		font-size: 1.5rem;
		color: #6366f1;
		transition: transform 0.2s ease;
	}

	.next-step {
		text-align: center;
		padding: 2rem;
		background: rgba(99, 102, 241, 0.1);
		border-radius: 12px;
		border: 1px solid rgba(99, 102, 241, 0.2);
	}

	.next-step p {
		margin: 0 0 1rem 0;
		color: #94a3b8;
	}

	.next-link {
		display: inline-block;
		padding: 0.75rem 1.5rem;
		background: linear-gradient(135deg, #6366f1, #8b5cf6);
		color: white;
		text-decoration: none;
		border-radius: 8px;
		font-weight: 500;
		transition: all 0.2s ease;
	}

	.next-link:hover {
		transform: translateY(-2px);
		box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
	}
</style>
