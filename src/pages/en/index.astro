---
import MathLayout from '../../layouts/MathLayout.astro';
import { getPath } from '../../utils/path';

const lang = 'en';
const currentPath = '/en/';
---

<MathLayout title="Math Learning Path" lang={lang} {currentPath}>
	<section class="hero">
		<div class="hero-content">
			<h1>Math Learning Path</h1>
			<p class="hero-subtitle">Monad Collisions, Beauty of Mathematics</p>
			
			<div class="pet-gallery">
				<img src={getPath('/pet01.gif')} alt="Pet 1" class="pet-gif" />
				<img src={getPath('/pet02.gif')} alt="Pet 2" class="pet-gif" />
				<img src={getPath('/pet03.gif')} alt="Pet 3" class="pet-gif" />
				<img src={getPath('/pet04.gif')} alt="Pet 4" class="pet-gif" />
				<img src={getPath('/pet05.gif')} alt="Pet 5" class="pet-gif" />
			</div>
			
			<div class="nav-buttons">
				<a href={getPath('/en/getting-started')} class="nav-btn primary">Get Started →</a>
				<a href={getPath('/en/university')} class="nav-btn">University Math →</a>
			</div>
		</div>
	</section>
</MathLayout>

<style>
	.hero {
		text-align: center;
		padding: 4rem 0;
		min-height: calc(100vh - 200px);
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.hero-content {
		max-width: 800px;
		margin: 0 auto;
	}

	.hero h1 {
		font-size: 3rem;
		margin-bottom: 0.5rem;
		background: linear-gradient(135deg, var(--primary), var(--accent));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.hero-subtitle {
		font-size: 1.25rem;
		color: var(--text-secondary);
		margin-bottom: 3rem;
	}

	.pet-gallery {
		display: flex;
		justify-content: center;
		gap: 1rem;
		margin-bottom: 3rem;
		flex-wrap: wrap;
	}

	.pet-gif {
		width: 120px;
		height: 120px;
		object-fit: cover;
		border-radius: 12px;
		border: 2px solid var(--border);
	}

	.nav-buttons {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	.nav-btn {
		padding: 1rem 2rem;
		border-radius: 12px;
		font-size: 1.1rem;
		font-weight: 500;
		text-decoration: none;
		transition: all 0.3s ease;
		background: rgba(99, 102, 241, 0.1);
		color: var(--text-primary);
		border: 1px solid var(--border);
	}

	.nav-btn:hover {
		transform: translateY(-2px);
		border-color: var(--primary);
	}

	.nav-btn.primary {
		background: linear-gradient(135deg, var(--primary), var(--secondary));
		color: white;
		border: none;
	}

	@media (max-width: 768px) {
		.hero h1 {
			font-size: 2rem;
		}

		.pet-gif {
			width: 80px;
			height: 80px;
		}

		.nav-btn {
			padding: 0.75rem 1.5rem;
			font-size: 1rem;
		}
	}
</style>
