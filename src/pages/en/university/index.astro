---
import MathLayout from '../../../layouts/MathLayout.astro';
import { getPath } from '../../../utils/path';

const lang = 'en';
const currentPath = '/en/university';
const title = 'University Mathematics';

const subjects = [
	{
		name: 'Set Theory',
		desc: 'From empty set, explore the structure and operations of sets',
		href: '/en/university/set-theory',
		icon: '∅',
		level: 1,
	},
	{
		name: 'Mathematical Logic',
		desc: 'The core of logic, formal systems and proof theory',
		href: '/en/university/math-logic',
		icon: '⟂',
		level: 1,
	},
	{
		name: 'Number Theory',
		desc: 'Structure and properties of integers, mysteries of prime distribution',
		href: '/en/university/number-theory',
		icon: 'ℕ',
		level: 2,
	},
	{
		name: 'Group Theory',
		desc: 'Algebraic structure of symmetry, four axioms control everything',
		href: '/en/university/group-theory',
		icon: '⊕',
		level: 3,
	},
	{
		name: 'Mathematical Analysis',
		desc: 'Real numbers, limits, continuity, differentiation and integration',
		href: '/en/university/analysis',
		icon: '∫',
		level: 4,
	},
	{
		name: 'Topology',
		desc: 'The soft geometry of space, the essence of continuity',
		href: '/en/university/topology',
		icon: '◈',
		level: 5,
	},
];
---

<MathLayout {title} lang={lang} {currentPath}>
	<article>
		<h1>{title}</h1>
		<p class="intro">Explore the core areas of mathematics, from foundations to abstraction.</p>

		<h2>Learning Path</h2>
		<div class="subjects-grid">
			{subjects.map(subject => (
				<a href={getPath(subject.href)} class="subject-card card">
					<span class="subject-icon">{subject.icon}</span>
					<div class="subject-info">
						<h3>{subject.name}</h3>
						<p>{subject.desc}</p>
					</div>
					<span class="subject-level">L{subject.level}</span>
					<span class="subject-arrow">→</span>
				</a>
			))}
		</div>
	</article>
</MathLayout>

<style>
	.intro {
		font-size: 1.1rem;
		margin-bottom: 2rem;
	}

	.subjects-grid {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.subject-card {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		text-decoration: none;
		transition: all 0.2s ease;
	}

	.subject-card:hover {
		transform: translateX(5px);
		border-color: var(--primary);
	}

	.subject-icon {
		font-size: 2.5rem;
		min-width: 60px;
		text-align: center;
		background: linear-gradient(135deg, var(--primary), var(--secondary));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.subject-info {
		flex: 1;
	}

	.subject-info h3 {
		margin: 0 0 0.25rem 0;
		color: var(--text-primary);
		font-size: 1.25rem;
	}

	.subject-info p {
		margin: 0;
		font-size: 0.9rem;
		color: var(--text-secondary);
	}

	.subject-level {
		padding: 0.25rem 0.5rem;
		background: rgba(99, 102, 241, 0.1);
		border-radius: 4px;
		font-size: 0.75rem;
		font-weight: bold;
		color: var(--primary);
	}

	.subject-arrow {
		font-size: 1.5rem;
		color: var(--primary);
		opacity: 0;
		transition: opacity 0.2s ease;
	}

	.subject-card:hover .subject-arrow {
		opacity: 1;
	}

	@media (max-width: 768px) {
		.subject-card {
			flex-direction: column;
			text-align: center;
			gap: 1rem;
		}

		.subject-level {
			order: -1;
		}

		.subject-arrow {
			display: none;
		}
	}
</style>
